# Copy to Pulumi.main.yaml. Keep the copy out of version control if it holds secrets.
# a run checks the pipeline program out of the repo.
config:
  software-factory-delivery:org: my-org
  software-factory-delivery:env: dev
  software-factory-delivery:owner: you@example.com
  software-factory-delivery:factoryProject: agent-factory-demo
  software-factory-delivery:approvers:
    - my-pulumi-user
